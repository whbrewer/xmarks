#!/usr/bin/env bash
# Background helper spawned (detached) by xmarks-sessionend:
# asks Claude for a natural recap of the session, then patches it into
# the sessions.jsonl file. Runs independent of the hook and Claude Code,
# so it can take whatever time the LLM call needs. Any failure exits
# quietly; the heuristic summary already written by the hook stands.

sid="$1" sessions="$2" cwd="$3" home="$4" reason="$5"
excerpt="$(cat)"

# Ask Claude for a natural recap paragraph from the session excerpt.
# Prepend context marker so Claude knows the input is the session content.
detail="$(cd "${TMPDIR:-/tmp}" && printf 'Session transcript:\n%s\n\nWrite a concise recap paragraph of this session. Describe what was done, the approach, and the outcome. Keep it to 2-4 sentences, specific and technical. Respond with only the paragraph, no preamble.\n' "$excerpt" \
  | XMARKS_IN_HOOK=1 timeout 45 claude -p --model "${XMARKS_SUMMARY_MODEL:-haiku}" \
      2>/dev/null | tr '\n' ' ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | cut -c1-700)"

[ -n "$detail" ] || exit 0

# Patch the detail into the sessions file (preserve everything else).
# Use flock if available (Linux), otherwise rely on atomic mv (macOS/BSD).
lock_cmd=""
if command -v flock >/dev/null 2>&1; then
  lock_cmd="flock -w 5 200"
fi

update_detail () {
  old="$([ -f "$sessions" ] && jq -c --arg s "$sid" 'select(.session_id == $s)' "$sessions" | tail -1)"
  starred="$(jq -r '.starred // false' <<<"${old:-null}" 2>/dev/null)"
  name="$(jq -r '.name // empty' <<<"${old:-null}" 2>/dev/null)"
  note="$(jq -r '.note // empty' <<<"${old:-null}" 2>/dev/null)"
  tool="$(jq -r '.tool // "claude"' <<<"${old:-null}" 2>/dev/null)"
  prompts="$(jq -r '.prompts // 0' <<<"${old:-null}" 2>/dev/null)"
  date="$(jq -r '.date // empty' <<<"${old:-null}" 2>/dev/null)"
  date="${date:-$(date '+%F %H:%M')}"
  reason="$(jq -r '.reason // "exit"' <<<"${old:-null}" 2>/dev/null)"
  summary="$(jq -r '.summary // empty' <<<"${old:-null}" 2>/dev/null)"
  {
    [ -f "$sessions" ] && jq -c --arg s "$sid" 'select(.session_id != $s)' "$sessions"
    jq -nc --arg date "$date" --arg sid "$sid" --arg dir "$cwd" \
      --arg home "$home" --arg tool "$tool" --arg reason "$reason" --arg summary "$summary" \
      --arg detail "$detail" --argjson prompts "${prompts:-0}" \
      --argjson starred "${starred:-false}" --arg name "$name" --arg note "$note" \
      '{date: $date, session_id: $sid, dir: $dir, home: $home, tool: $tool,
        reason: $reason, summary: $summary,
        detail: (if $detail == "" then null else $detail end),
        prompts: $prompts,
        starred: $starred,
        name: (if $name == "" then null else $name end),
        note: (if $note == "" then null else $note end)}'
  } > "$sessions.tmp" && mv "$sessions.tmp" "$sessions"
}

if [ -n "$lock_cmd" ]; then
  ( $lock_cmd; update_detail ) 200>"$sessions.lock" 2>/dev/null
else
  update_detail
fi
